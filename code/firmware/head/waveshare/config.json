{
  "manufacturer": "desk-robot",
  "type": "desk-robot-waveshare-s3-cam",
  "target": "esp32s3",
  "builds": [
    {
      "name": "desk-robot-waveshare-s3-cam",
      "build_options": {
        "camera_hmirror": false,
        "camera_vflip": true
      },
      "sdkconfig_append": [
        "CONFIG_SPIRAM_MODE_OCT=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m.csv\"",
        "CONFIG_SCCB_HARDWARE_I2C_PORT0=n",
        "CONFIG_SCCB_HARDWARE_I2C_PORT1=y",
        "CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y",
        "CONFIG_USE_AUDIO_PROCESSOR=y",
        "CONFIG_USE_DEVICE_AEC=y",
        "CONFIG_USE_SERVER_AEC=n",
        "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
        "CONFIG_ESP_CONSOLE_UART_DEFAULT=n",
        "CONFIG_ESP_CONSOLE_UART_CUSTOM=n",
        "CONFIG_ESP_CONSOLE_USB_CDC=n",
        "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
        "CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y",
        "CONFIG_DESK_ROBOT_ID=\"robot-01\"",
        "CONFIG_DESK_ROBOT_TOKEN=\"\""
      ]
    }
  ]
}
