{
  "manufacturer": "desk-robot",
  "type": "desk-robot-sense-s3",
  "target": "esp32s3",
  "builds": [
    {
      "name": "desk-robot-sense-s3",
      "build_options": {
        "camera_hmirror": false,
        "camera_vflip": false
      },
      "sdkconfig_append": [
        "CONFIG_SPIRAM_MODE_OCT=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
        "CONFIG_SCCB_HARDWARE_I2C_PORT0=y",
        "CONFIG_SCCB_HARDWARE_I2C_PORT1=n",
        "CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y",
        "CONFIG_DESK_ROBOT_ID=\"robot-01\"",
        "CONFIG_DESK_ROBOT_TOKEN=\"\"",
        "CONFIG_USE_AUDIO_PROCESSOR=y",
        "CONFIG_USE_DEVICE_AEC=y",
        "CONFIG_USE_SERVER_AEC=n"
      ]
    }
  ]
}
